{
  "name": "clipper-studio",
  "productName": "Clipper Studio",
  "version": "0.1.0",
  "description": "Desktop video clipper & caption studio with offline STT",
  "author": "Clipper Studio",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node phase2-test.js && node phase3-test.js && node phase4a-test.js && node phase4b-test.js && node phase5-test.js && node phase6-test.js && node phase7-test.js && node hook-engine-test.js && node hook-engine-v2-test.js && node editorial-opening-test.js && node duration-engine-test.js && node cut-to-face-test.js && node mode-lite-test.js && node preview-caption-sync-test.js && node encoder-fallback-test.js && node translation-words-test.js && node deep-title-engine-test.js && node deep-e2e-test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.clipperstudio.desktop",
    "productName": "Clipper Studio",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "script.js",
      "server.js",
      "clipme-prompt.js",
      "clipme-hook-engine.js",
      "clipme-deep-title-engine.js",
      "clipme-opening-engine.js",
      "clipme-duration-engine.js",
      "clipme-caption-engine.js",
      "clipme-caption-prompt.js",
      "clipme-hardware.js",
      "clipme-localai.js",
      "clipme-active-speaker.js",
      "clipme-cut-to-face.js",
      "transcribe_faster_whisper.py",
      "stt-engine.py",
      "clipme-speaker-detect.py",
      "clipme-face-detect.py",
      "build/icon.png",
      "build/icon.ico",
      "stt-config.json",
      "stt/**/*.py",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "stt/**/*.py",
      "stt-engine.py",
      "stt-config.json",
      "transcribe_faster_whisper.py",
      "clipme-face-detect.py",
      "clipme-speaker-detect.py"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": ".venv",
        "to": ".venv"
      },
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  }
}